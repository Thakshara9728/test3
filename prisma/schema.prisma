// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Channel {
  id              String    @id @default(cuid())
  name            String
  niche           String
  description     String?
  status          String    @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED

  // Claude Projects integration
  claudeProjectId String?

  // Settings stored as JSON
  settings        String    @default("{}")

  prompts         Prompt[]
  scripts         Script[]
  knowledgeBase   KnowledgeBase[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Prompt {
  id              String    @id @default(cuid())
  channelId       String
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  type            String    // SCRIPT, IMAGE, VIDEO
  name            String
  systemPrompt    String

  // Claude API settings
  useExtendedThinking Boolean @default(false)
  thinkingBudget  Int?
  useWebSearch    Boolean    @default(false)
  model           String     @default("claude-sonnet-4-20250514")
  maxTokens       Int        @default(4096)
  temperature     Float      @default(1.0)

  version         Int        @default(1)
  isActive        Boolean    @default(true)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([channelId, type, isActive])
}

model Script {
  id              String    @id @default(cuid())
  channelId       String
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  title           String
  topic           String
  content         String

  // Metadata
  wordCount       Int?
  duration        Int?
  status          String    @default("DRAFT") // DRAFT, GENERATING, GENERATED, REVIEWED

  // Generated assets
  imagePrompts    ImagePrompt[]
  videoPrompts    VideoPrompt[]

  // Claude API metadata
  thinkingContent String?
  tokensUsed      Int?
  cost            Float?

  // Context tracking
  contextUsed     String?   // IDs of knowledge base items used
  previousScriptId String?  // Link to previous script for context chain

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([channelId, status])
}

model ImagePrompt {
  id              String    @id @default(cuid())
  scriptId        String
  script          Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  type            String    // THUMBNAIL, B_ROLL, SCENE
  prompt          String
  negativePrompt  String?

  // Settings for image generation stored as JSON
  settings        String    @default("{}")

  // Generated image
  imageUrl        String?
  generatedAt     DateTime?

  order           Int

  createdAt       DateTime  @default(now())

  @@index([scriptId])
}

model VideoPrompt {
  id              String    @id @default(cuid())
  scriptId        String
  script          Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  prompt          String
  duration        Int?
  settings        String    @default("{}")

  // Generated video
  videoUrl        String?
  generatedAt     DateTime?

  order           Int

  createdAt       DateTime  @default(now())

  @@index([scriptId])
}

model KnowledgeBase {
  id              String    @id @default(cuid())
  channelId       String
  channel         Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  type            String    // GUIDELINE, EXAMPLE, BRAND_VOICE, STYLE_GUIDE, REFERENCE
  title           String
  content         String    // The actual knowledge content

  // Optional metadata
  description     String?
  tags            String?   // Comma-separated tags
  priority        Int       @default(0) // Higher = more important in context

  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([channelId, isActive])
  @@index([channelId, type])
}

model ClaudeTool {
  id                    String    @id @default(cuid())
  name                  String
  description           String?

  // Three prompts as requested
  mainPrompt            String    // Main system prompt
  firstMessagePrompt    String    // Initial message to start conversation
  continuePartsPrompt   String    // Prompt for continuing/extending content

  // Claude API settings
  model                 String    @default("claude-sonnet-4-5-20250929")
  useExtendedThinking   Boolean   @default(true)
  thinkingBudget        Int?      @default(10000) // Tokens for thinking
  useUltraThink         Boolean   @default(false) // Ultra thinking mode (50k tokens)
  useWebSearch          Boolean   @default(true)
  usePromptCaching      Boolean   @default(true) // Cache system prompt to save $
  maxTokens             Int       @default(8000)
  temperature           Float     @default(1.0)

  // Status
  isActive              Boolean   @default(true)

  // Conversation history
  conversations         ToolConversation[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isActive])
}

model ToolConversation {
  id                    String    @id @default(cuid())
  toolId                String
  tool                  ClaudeTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  // Conversation data
  messages              String    // JSON array of messages
  thinkingContent       String?   // Extended thinking output

  // Metadata
  tokensUsed            Int?
  cost                  Float?
  webSearchUsed         Boolean   @default(false)

  createdAt             DateTime  @default(now())

  @@index([toolId])
}
